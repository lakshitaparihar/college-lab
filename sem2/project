def caeser(operation,ogtxt,shift):
    if operation=="decode":
        shift*= -1
    l=["a","b","c","d","e","f","g","h","i","j","k","l","m","n","o","p","q","r","s","t","u","v","w","x","y","z"]
    for i in ogtxt:
        if i.isalpha()==True:
            p+=(l[(l.index(i)+shift)%26])
        else:
            p+=i
    print(f"{operation}d result is:",p,sep="")   


